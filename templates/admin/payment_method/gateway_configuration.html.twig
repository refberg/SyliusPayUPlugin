{% set config = hookable_metadata.context.form.gatewayConfig.config %}

<div class="col-12">
    <div class="row">
        <div class="col-12 col-md-6">{{ form_row(config.environment) }}</div>
        <div class="col-12 col-md-6">{{ form_row(config.pos_id) }}</div>
        <div class="col-12 col-md-6">{{ form_row(config.second_key) }}</div>
        <div class="col-12 col-md-6">{{ form_row(config.oauth_client_id) }}</div>
        <div class="col-12 col-md-6">{{ form_row(config.oauth_client_secret) }}</div>
    </div>

    {% set code = hookable_metadata.context.form.vars.data.code|default(null) %}
    {% if code %}
        <div class="alert alert-info mt-3">
            {{ 'refberg_payu.form.gateway_configuration.notify_url'|trans }}
            <code>{{ url('sylius_payment_method_notify', {code: code}) }}</code>
        </div>
    {% endif %}
</div>
