{
    "name": "refberg/sylius-payu-plugin",
    "type": "sylius-plugin",
    "description": "PayU REST API payment gateway for Sylius 2, built on Payment Requests (no Payum).",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "payu",
        "payment",
        "payment-request"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Refberg"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/log": "^3.0",
        "sylius/sylius": "^2.2 || ^2.3",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/http-client-contracts": "^3.4"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^2.2.0@alpha || ^2.3.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Refberg\\SyliusPayUPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Refberg\\SyliusPayUPlugin\\": ["tests/", "tests/TestApplication/src/"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migrations:migrate -n"
        ],
        "test-app-init": [
            "@database-reset"
        ]
    }
}
